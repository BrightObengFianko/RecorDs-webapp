# PostgreSQL Database Configuration
DATABASE_URL=
DB_USER=postgres
DB_HOST=localhost
DB_NAME=record_db
DB_PASSWORD=your_password_here
DB_PORT=5432
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Server Configuration
PORT=5000
NODE_ENV=development
TRUST_PROXY=false
BACKUP_DIR=./backups

# Use ENV_FILE=.env.local when starting the separate local server.
# The local sync CLI reads ONLINE_DATABASE_URL only from the local machine.
ONLINE_DATABASE_URL=
ONLINE_DB_SSL=true
ONLINE_DB_SSL_REJECT_UNAUTHORIZED=false
SYNC_BATCH_SIZE=100

# JWT Security
JWT_SECRET=your_super_secret_key_change_this

# Google Sheets Configuration
# Get your Sheet ID from the URL: https://docs.google.com/spreadsheets/d/{SHEET_ID}/edit
GOOGLE_SHEET_ID=YOUR_GOOGLE_SHEET_ID_HERE

# Default branch for imported records
DEFAULT_BRANCH_ID=1

# Arkesel SMS balance and bundle configuration
ARKESEL_API_KEY=your_arkesel_api_key_here
ARKESEL_BALANCE_URL=https://sms.arkesel.com/api/v2/sms/balance
ARKESEL_SMS_BUNDLE=
ARKESEL_BUNDLE_URL=
N8N_WEBHOOK_SECRET=replace_with_a_long_random_secret
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TIMEOUT_MS=10000
CORS_ORIGIN=

# Path to Google Service Account JSON file
SERVICE_ACCOUNT_PATH=./service-account.json
APP_BASE_URL=https://your-records-domain.example
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=RecorDs
