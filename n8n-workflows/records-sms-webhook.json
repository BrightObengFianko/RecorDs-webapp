      "name": "Code in JavaScript1"
    },
    {
      "parameters": {
        "jsCode": "const name = $json.name;\nconst record_id = $json.id;\n\n// Clean registrar\nconst registrar = String($json.registrar || \"\")\n  .trim()\n  .toUpperCase();\n\n// Clean category\nconst category = String($json.category || \"\")\n  .trim()\n  .toUpperCase();\n\n// Determine certificate type\nconst certificateType = category === \"DEATH\"\n  ? \"Death certificate\"\n  : \"Birth certificate\";\n\nlet message;\n\nif (registrar === \"OFFICE\") {\n\n  message = `Dear ${name}, your ${certificateType} is ready. Visit Birth & Deaths Registry, Kasoa, Mon-Fri, 8am-4:30pm to collect your certificate. Thank you.`;\n\n} else if (registrar === \"POLYCLINIC\") {\n\n  message = `Dear ${name}, your ${certificateType} is ready. Visit Kasoa Polyclinic, Mon-Fri, 8am-3pm, to collect your certificate. Thank you.`;\n\n} else if (registrar === \"NEW MARKET\") {\n\n  message = `Dear ${name}, your ${certificateType} is ready. Visit New Market Polyclinic, Kasoa, Mon-Fri, 8am-4:30pm, to collect your certificate. Thank you.`;\n\n} else {\n\n \n  message = `Dear ${name}, your ${certificateType} is ready. Visit Birth & Deaths Registry, Kasoa, Mon-Fri, 8am-4:30pm to collect your certificate. Thank you.`;\n}\n\nreturn {\n  json: {\n    ...$json,\n    record_id: record_id,\n    registrar_checked: registrar,\n    category_checked: category,\n    certificate_type: certificateType,\n    message: message\n  }\n};"
      },
