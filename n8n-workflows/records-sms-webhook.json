      "parameters": {
        "jsCode": "const arkesel = $json;\n\nconst original = $('prepare sms2').item.json;\n\nreturn {\n  json: {\n    record_id: original.record_id,\n    phone_number: original.phone_number,\n    message: original.message,\n    arkesel_status: arkesel.status,\n    arkesel_response: arkesel\n  }\n};"
